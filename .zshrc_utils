# Function to source a file if it exists
source_if_exists() {
    if [[ -f "$1" ]]; then
        source "$1"
    fi
}

# Function to get any variable from private config
get_private_config() {
    local var_name="$1"
    if [[ -z "$var_name" ]]; then
        echo "Usage: get_private_config <variable_name>" >&2
        return 1
    fi
    grep "${var_name}=" ~/.dotfiles/.zshrc.private 2>/dev/null | cut -d'=' -f2 | tr -d '"'
}
